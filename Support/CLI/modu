#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
APP_BUNDLE="${SCRIPT_DIR:h:h:h}"
INFO_PLIST="$APP_BUNDLE/Contents/Info.plist"

usage() {
  print 'Usage: modu <directory-or-file>'
  print '       modu --help'
  print '       modu --version'
}

if (( $# != 1 )); then
  usage >&2
  exit 2
fi

case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  --version)
    version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$INFO_PLIST")"
    build="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$INFO_PLIST")"
    print "modu $version ($build)"
    exit 0
    ;;
  -*)
    print -u2 "modu: unknown option: $1"
    usage >&2
    exit 2
    ;;
esac

target="$1"
if [[ ! -e "$target" ]]; then
  print -u2 "modu: path does not exist: $target"
  exit 1
fi

resolved_target="${target:A}"
if [[ -d "$resolved_target" ]]; then
  open_targets=("$resolved_target")
elif [[ -f "$resolved_target" ]]; then
  open_targets=("${resolved_target:h}" "$resolved_target")
else
  print -u2 "modu: path is not a regular file or directory: $target"
  exit 1
fi

app_executable="$APP_BUNDLE/Contents/MacOS/MoDu"
typeset -i app_is_running=0
while IFS= read -r running_command; do
  if [[ "$running_command" == "$app_executable" ]]; then
    app_is_running=1
    break
  fi
done < <(/bin/ps -axo command=)

encode_path() {
  /usr/bin/printf '%s' "$1" \
    | /usr/bin/base64 \
    | /usr/bin/tr '/+' '_-' \
    | /usr/bin/tr -d '=\n'
}

request_id="$(/usr/bin/uuidgen | /usr/bin/tr '[:upper:]' '[:lower:]')"
if (( app_is_running )); then
  request_mode='new'
else
  request_mode='reuse'
fi
request_marker="modu-cli://open/$request_id?mode=$request_mode&workspace=$(encode_path "${open_targets[1]}")"
if (( ${#open_targets[@]} == 2 )); then
  request_marker+="&document=$(encode_path "${open_targets[2]}")"
fi

/usr/bin/open -a "$APP_BUNDLE" "$request_marker" "${open_targets[@]}"
